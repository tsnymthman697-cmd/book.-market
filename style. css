/* --- إعدادات أساسية وتنسيق عام --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Cairo', sans-serif;
    scroll-behavior: smooth;
}

body {
    background-color: #f8fafc;
    color: #1e293b;
    line-height: 1.7;
    direction: rtl;
    text-align: right;
}

/* --- الهيدر (Header) --- */
header {
    background-color: #0f172a;
    color: #ffffff;
    padding: 1rem 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

header h1 {
    font-size: 1.6rem;
    color: #38bdf8;
    font-weight: 700;
}

nav {
    display: flex;
    gap: 1.5rem;
}

nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.3s ease;
}

nav a:hover {
    color: #38bdf8;
}

/* --- القسم الرئيسي (Hero Section) --- */
.hero {
    background: linear-gradient(rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.88)), url('https://placehold.co/1200x600?text=Library') center/cover no-repeat;
    color: #ffffff;
    text-align: center;
    padding: 7rem 1.5rem;
}

.hero h2 {
    font-size: 2.8rem;
    margin-bottom: 1rem;
    font-weight: 700;
}

.hero p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #cbd5e1;
}

.hero input[type="text"] {
    width: 100%;
    max-width: 500px;
    padding: 1rem 1.5rem;
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    outline: none;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    margin-bottom: 1.5rem;
}

.main-button {
    display: inline-block;
    background-color: #0284c7;
    color: #ffffff;
    padding: 0.85rem 2.2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s ease, transform 0.2s ease;
}

.main-button:hover {
    background-color: #0369a1;
    transform: translateY(-3px);
}

/* --- الأقسام العامة --- */
section {
    padding: 5rem 5%;
    max-width: 1250px;
    margin: 0 auto;
}

section h2 {
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 3rem;
    color: #0f172a;
    font-weight: 700;
    position: relative;
}

section h2::after {
    content: '';
    display: block;
    width: 70px;
    height: 4px;
    background-color: #0284c7;
    margin: 12px auto 0;
    border-radius: 2px;
}

/* --- قسم الكتب (Buy Books) --- */
.book-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
}

.book {
    background-color: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid #f1f5f9;
    padding-bottom: 1.5rem;
}

.book:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
}

.book img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    background-color: #f1f5f9;
}

.book h3 {
    font-size: 1.25rem;
    margin: 1.2rem 1rem 0.5rem;
    color: #0f172a;
    font-weight: 700;
}

.book p {
    color: #0284c7;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 1.2rem;
}

.book button, #sell button {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.8rem;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    font-weight: 600;
    width: calc(100% - 3rem);
    margin: 0 auto;
    transition: background-color 0.3s ease;
}

.book button:hover {
    background-color: #059669;
}

/* --- قسم بيع الكتب (Sell Books) --- */
#sell {
    background-color: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    max-width: 650px;
    margin: 3rem auto;
    border: 1px solid #f1f5f9;
    padding: 3rem 2.5rem;
}

#sell input {
    display: block;
    width: 100%;
    padding: 0.95rem 1.2rem;
    margin-bottom: 1.5rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-size: 1rem;
    outline: none;
    background-color: #f8fafc;
}

#sell input:focus {
    border-color: #0284c7;
    background-color: #ffffff;
}

#sell button {
    background-color: #0284c7;
    width: 100%;
    padding: 0.95rem;
}

#sell button:hover {
    background-color: #0369a1;
}

/* --- من نحن واتصل بنا --- */
#about, #contact {
    text-align: center;
    background-color: #ffffff;
    margin-bottom: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    border: 1px solid #f1f5f9;
}

#about p, #contact p {
    color: #64748b;
    font-size: 1.15rem;
    max-width: 750px;
    margin: 0.8rem auto;
}

/* --- التذييل (Footer) --- */
footer {
    background-color: #0f172a;
    color: #94a3b8;
    text-align: center;
    padding: 2rem 1rem;
    font-size: 0.95rem;
    margin-top: 4rem;
}

/* --- التجاوب مع الهواتف --- */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }
    nav {
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }
    .hero h2 {
        font-size: 2.1rem;
    }
}